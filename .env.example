# ==========================================
# Codebase Onboarder Environment Configuration
# ==========================================

# Environment
NODE_ENV=development
PORT=4000
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173

# AI & LLM Provider Settings ("auto", "gemini", or "openai")
LLM_PROVIDER=auto

# Google Gemini (Set GEMINI_API_KEY to use Gemini models)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI Settings (Set OPENAI_API_KEY to use OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=codebase_chunks

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/codebase_onboarder

# Cache & Background Jobs (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Service Endpoints
AI_SERVICE_URL=http://localhost:8000
BACKEND_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000/api

# Storage & Limits
REPO_STORAGE_PATH=./data/repos
MAX_REPO_SIZE_MB=250

# Security & Sessions
JWT_SECRET=your_super_secret_jwt_session_key_here

# GitHub OAuth & Private Repositories (Optional, demo mode supported)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:5173/auth/callback
